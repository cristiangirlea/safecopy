      "Bash(cargo tree *)",
      "Bash(cargo metadata *)",
      "Bash(cargo fuzz *)",
      "Bash(cargo +* fmt *)",
      "Bash(cargo +* check *)",
      "Bash(cargo +* clippy *)",
      "Bash(cargo +* test *)",
      "Bash(cargo +* build *)",
      "Bash(cargo +* fuzz *)",
      "Bash(rustup show *)",
      "Bash(rustup target list *)",
      "Bash(rustup toolchain list *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "PowerShell(cargo fmt *)",
      "PowerShell(cargo check *)",
      "PowerShell(cargo clippy *)",
      "PowerShell(cargo test *)",
      "PowerShell(cargo build *)",
      "PowerShell(cargo doc *)",
      "PowerShell(cargo deny *)",
      "PowerShell(cargo tree *)",
      "PowerShell(cargo metadata *)",
      "PowerShell(cargo fuzz *)",
      "PowerShell(cargo +* fmt *)",
      "PowerShell(cargo +* check *)",
      "PowerShell(cargo +* clippy *)",
      "PowerShell(cargo +* test *)",
      "PowerShell(cargo +* build *)",
      "PowerShell(cargo +* fuzz *)",
      "PowerShell(rustup show *)",
      "PowerShell(rustup target list *)",
      "PowerShell(rustup toolchain list *)",
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git show *)",
      "PowerShell(gh pr view *)",
      "PowerShell(gh pr checks *)",
      "PowerShell(gh pr diff *)",
      "PowerShell(gh pr list *)",
      "PowerShell(gh issue view *)",
      "PowerShell(gh issue list *)",
      "PowerShell(gh run view *)",
      "PowerShell(gh run list *)"
    ],
    "ask": [
      "Bash(gh pr merge *)",
      "Bash(cargo publish *)",
      "Bash(cargo +* publish *)",
      "PowerShell(gh pr merge *)",
      "PowerShell(cargo publish *)",
      "PowerShell(cargo +* publish *)"
    ],
    "deny": [
      "Bash(git push *--force*)",
      "Bash(git push *-f)",
      "Bash(git push *-f *)",
      "Bash(git push *+*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main*)",
      "Bash(git push *refs/heads/main*)",
      "Bash(gh pr merge *--auto*)",
      "Bash(gh pr merge *--admin*)",
      "Bash(gh release *)",
      "PowerShell(git push *--force*)",
      "PowerShell(git push *-f)",
      "PowerShell(git push *-f *)",
      "PowerShell(git push *+*)",
      "PowerShell(git push * main)",
      "PowerShell(git push * main *)",
      "PowerShell(git push *:main*)",
      "PowerShell(git push *refs/heads/main*)",
      "PowerShell(gh pr merge *--auto*)",
      "PowerShell(gh pr merge *--admin*)",
      "PowerShell(gh release *)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/.cargo/credentials*)"
    ]
  }
}
